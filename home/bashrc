# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ~/.local/bin holds nvim, tree-sitter and (on Ubuntu) mise; .profile only adds it for login shells
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# Only run neofetch when installed and not in VS Code
if command -v neofetch >/dev/null && [ -z "$VSCODE_INJECTION" ] && [ "$TERM_PROGRAM" != "vscode" ]; then
    neofetch
fi

# mise: /usr/bin/mise from the apt repo on Debian, ~/.local/bin/mise from the installer on Ubuntu
command -v mise >/dev/null && eval "$(mise activate bash)"

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

[ -f ~/.fzf.bash ] && source ~/.fzf.bash

# === WSL (work machine: Ubuntu under Windows Terminal) ===
if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    # /etc/wsl.conf turns off appendWindowsPath (slow completion, .exe files shadowing Linux tools).
    # Keep the few Windows tools nvim and gh rely on reachable: win32yank.exe, explorer.exe, powershell.exe.
    for d in /mnt/c/Windows/System32 /mnt/c/Windows /mnt/c/Windows/System32/WindowsPowerShell/v1.0; do
        case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$PATH:$d" ;; esac
    done
    # open links in the Windows browser (wslview comes from the wslu package)
    if command -v wslview >/dev/null; then export BROWSER=wslview; else export BROWSER=explorer.exe; fi
fi

# global dotnet tools (roslyn-language-server for nvim)
export PATH="$HOME/.dotnet/tools:$PATH"

# machine-local settings and secrets; not in the dotfiles repo
[ -f ~/.bashrc.local ] && . ~/.bashrc.local
