# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Start tmux in every new terminal tab; each tab gets its own session. Not in VS Code's terminal.
if command -v tmux >/dev/null 2>&1 && [ -z "$TMUX" ] && [[ "$TERM" != screen* ]] && [[ "$TERM" != tmux* ]] &&
    [ -z "$VSCODE_INJECTION" ] && [ "$TERM_PROGRAM" != "vscode" ]; then
    exec tmux new-session
fi

# === History ===
# Unlimited, timestamped, shared across every tmux pane: __prompt (below) runs `history -a; history -n`
# after each command, so Ctrl-R in one shell sees what was typed in another.
HISTCONTROL=ignoreboth:erasedups # skip lines starting with a space and keep only the latest copy of a command
HISTSIZE=-1
HISTFILESIZE=-1
HISTTIMEFORMAT='%F %T '
HISTIGNORE='ls:ll:la:l:cd:cd -:cd ..:pwd:exit:clear:history:bg:fg:jobs' # not worth recalling
shopt -s histappend # append to the history file, don't overwrite it

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
shopt -s globstar

# `cd maxdop` from anywhere. Not exported on purpose: an exported CDPATH changes what `cd` means in scripts.
CDPATH=.:$HOME/projects

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

export EDITOR=nvim
export VISUAL=nvim

# === Aliases ===
# Merged from this repo and the WSL work machine; all commented out until reviewed.
# Work-only ones (ops, nnuke, update-all, rgl) are in the work machine's ~/.bashrc.local.

# ls
#alias ll='ls -l'
#alias la='ls -A'
#alias l='ls -CF'

# editor
alias vi='nvim'
alias vim='nvim'
alias myprofile='nvim ~/.bashrc'

alias glol='git log --graph --pretty="%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset"'
alias myip='curl -sSL api.ipify.org; echo'     # work machine had: echo "$(curl -sSL api.ipify.org)"
alias weather='curl https://wttr.in'

# Claude Code without a project: ~/chat is empty and not a git repo, so only ~/.claude/CLAUDE.md applies.
#   chat          interactive session; chat -c continues the last one
#   ask "..."     one-shot answer printed in this shell
# Both run in a subshell, so the current directory never changes.
#chat() { ( mkdir -p "$HOME/chat" && cd "$HOME/chat" && exec claude "$@" ); }
#ask()  { ( mkdir -p "$HOME/chat" && cd "$HOME/chat" && claude -p "$*" ); }

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ~/.local/bin holds nvim, tree-sitter and (on Ubuntu) mise; .profile only adds it for login shells
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# Only run neofetch when installed and not in VS Code
if command -v neofetch >/dev/null && [ -z "$VSCODE_INJECTION" ] && [ "$TERM_PROGRAM" != "vscode" ]; then
    neofetch
fi

# mise: /usr/bin/mise from the apt repo on Debian, ~/.local/bin/mise from the installer on Ubuntu
command -v mise >/dev/null && eval "$(mise activate bash)"

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

[ -f ~/.fzf.bash ] && source ~/.fzf.bash

# === WSL (work machine: Ubuntu under Windows Terminal) ===
if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    # /etc/wsl.conf turns off appendWindowsPath (slow completion, .exe files shadowing Linux tools).
    # Keep the few Windows tools nvim and gh rely on reachable: win32yank.exe, explorer.exe, powershell.exe.
    for d in /mnt/c/Windows/System32 /mnt/c/Windows /mnt/c/Windows/System32/WindowsPowerShell/v1.0; do
        case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$PATH:$d" ;; esac
    done
    # open links in the Windows browser (wslview comes from the wslu package)
    if command -v wslview >/dev/null; then export BROWSER=wslview; else export BROWSER=explorer.exe; fi
fi

# global dotnet tools (roslyn-language-server for nvim)
export PATH="$HOME/.dotnet/tools:$PATH"

# Prompt: cwd and ❯ (red after a failed command); user@host only over SSH.
# Git branch and dirty state are in the tmux status bar, so not repeated here.
PROMPT_DIRTRIM=3
__prompt() {
    local status=$? host="" char_color='\[\e[38;2;189;147;249m\]' # Dracula purple
    history -a; history -n # write this shell's new commands, pull in the other panes' (see History above)
    [ "$status" -ne 0 ] && char_color='\[\e[38;2;255;85;85m\]'     # Dracula red
    [ -n "${SSH_CONNECTION:-}" ] && host='\[\e[38;2;255;184;108m\]\u@\h\[\e[0m\] ' # Dracula orange
    PS1="${host}\[\e[38;2;139;233;253m\]\w\[\e[0m\] ${char_color}❯\[\e[0m\] "
}
# after `mise activate`, and first so $? is still the last command's; keeps the hooks mise and others add
PROMPT_COMMAND="__prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# machine-local settings and secrets; not in the dotfiles repo
[ -f ~/.bashrc.local ] && . ~/.bashrc.local
