[user]
	name = Page Brooks
	# email, signingkey and credential helpers differ per machine: see ~/.gitconfig.local
[core]
	autocrlf = input
	ignorecase = false
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Dracula
	# Dracula red/green blended into the #282a36 background: lines at 20%, changed words at 40%
	minus-style = syntax "#53333c"
	minus-emph-style = syntax "#7e3b42"
	plus-style = syntax "#305444"
	plus-emph-style = syntax "#387d52"
	zero-style = syntax
	line-numbers-minus-style = "#ff5555"
	line-numbers-plus-style = "#50fa7b"
	line-numbers-zero-style = "#6272a4"
	line-numbers-left-style = "#44475a"
	line-numbers-right-style = "#44475a"
	file-style = "#bd93f9" bold
	file-decoration-style = "#bd93f9" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#8be9fd"
	hunk-header-line-number-style = "#f1fa8c"
	hunk-header-decoration-style = "#6272a4" box
[gpg]
	format = ssh
[commit]
	gpgsign = true
[init]
	defaultBranch = main
# Linear history: pull and merge fast-forward only; rebase feature branches onto their base.
# Release and hotfix branches are the exception, so pass --no-ff explicitly when merging those.
[pull]
	rebase = true
	ff = only
[merge]
	ff = only
[rebase]
	autoStash = true
	updateRefs = true
[branch]
	autoSetupRebase = always
[rerere]
	enabled = true
[push]
	autoSetupRemote = true
	default = current
# Merged from this repo and the WSL work machine; all commented out until reviewed.
# Work-only ones (ch, up, pr, repo) are in the work machine's ~/.gitconfig.local.
[alias]
	#lg = log --color --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	#ca = commit --amend --no-edit
	#st = status
	#f  = fetch
# per-machine settings, last so they can override anything above (e.g. gpgsign = false at work)
[include]
	path = ~/.gitconfig.local
